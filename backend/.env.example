DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/field_worker_db
APP_DATABASE_URL=postgresql://fieldpro_app:YOUR_PASSWORD@localhost:5432/field_worker_db
NODE_ENV=development
PORT=4100
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080
JWT_ACCESS_SECRET=change-me-in-production-use-a-long-random-value
JWT_REFRESH_SECRET=change-me-too-in-production-use-a-different-value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d
FILE_DRIVER=local
FILE_LOCAL_DIR=./uploads
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WEBHOOK_BASE=https://your-ngrok-host
TWILIO_SKIP_SIGNATURE=false
SETTINGS_ENCRYPTION_KEY=fieldpro-settings-dev-key
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
APP_PUBLIC_URL=http://localhost:8080
